# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found at: supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Stripe (for $100 founder onboarding fee) ─────────────────────────────────
# Found at: dashboard.stripe.com → Developers → API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
STRIPE_SECRET_KEY=sk_live_your-key-here

# ─── Flutterwave (for escrow and African payments) ────────────────────────────
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_your-key-here
FLUTTERWAVE_SECRET_KEY=FLWSECK_your-key-here

# ─── Vercel (used for web app and API routes) ─────────────────────────────────
VERCEL_URL=https://waaw.co

# ─── Loca8tor (postcode verification) ────────────────────────────────────────
EXPO_PUBLIC_LOCA8TOR_API_KEY=your-loca8tor-key-here
EXPO_PUBLIC_LOCA8TOR_BASE_URL=https://api.loca8tor.com/v1

# ─── Expo push notifications ─────────────────────────────────────────────────
EXPO_PROJECT_ID=your-expo-project-id

# ─── App config ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_WAAW_COMMISSION_RATE=0.05
